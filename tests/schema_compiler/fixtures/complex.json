{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "year_founded": {
      "type": "integer",
      "minimum": 1800
    },
    "industry": {
      "type": "string",
      "enum": ["Technology", "Healthcare", "Finance", "Retail", "Manufacturing"]
    },
    "headquarters": {
      "$ref": "#/definitions/Address"
    },
    "offices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Address"
      }
    },
    "employees": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Person"
      }
    },
    "active": {
      "type": "boolean"
    },
    "revenue": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "contact_info": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["email", "phone", "mail"]
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["type", "value"]
    }
  },
  "required": ["name", "year_founded", "headquarters"],
  "definitions": {
    "Address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "description": "ISO country code"
        }
      },
      "required": ["street", "city", "country"]
    },
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "department": {
          "type": "string",
          "enum": ["Engineering", "Marketing", "Sales", "HR", "Finance", "Operations", "Executive"]
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "joined_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": ["id", "name", "department"]
    }
  }
} 